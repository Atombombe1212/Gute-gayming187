function AdvanceTech:RestoreAppearance()

    for part, transparency in pairs(
        self.State.Privacy.OriginalTransparencies
    ) do

        if part and part.Parent then
            part.LocalTransparencyModifier =
                transparency
        end
    end

    self.State.Privacy.OriginalTransparencies = {}
end

function AdvanceTech:ApplyInvisibility()

    local character = LocalPlayer.Character

    if not character then
        return
    end

    for _, descendant in ipairs(
        character:GetDescendants()
    ) do

        if descendant:IsA("BasePart")
            or descendant:IsA("Decal") then

            if not self.State.Privacy.OriginalTransparencies[
                descendant
            ] then

                self.State.Privacy.OriginalTransparencies[
                    descendant
                ] = descendant.LocalTransparencyModifier
            end

            descendant.LocalTransparencyModifier = 1
        end
    end
end

