function AdvanceTech:IsESPEnemy(player)

    if not player or player == LocalPlayer then
        return false
    end

    if not self.Settings.ESP.TeamCheck then
        return true
    end

    return player.Team ~= LocalPlayer.Team
end

function AdvanceTech:CreateESP(player)

    if player == LocalPlayer then
        return
    end

    if self.State.ESP.Objects[player] then
        return
    end

    local text = Drawing.new("Text")

    text.Visible = false

    text.Size =
        self.Settings.ESP.TextSize

    text.Center =
        self.Settings.ESP.Center

    text.Outline =
        self.Settings.ESP.Outline

    text.OutlineColor =
        self.Settings.ESP.OutlineColor

    text.Color =
        self.Settings.ESP.TextColor

    text.Transparency =
        self.Settings.ESP.TextTransparency

    if self.Settings.ESP.Font then
        text.Font =
            self.Settings.ESP.Font
    end

    self.State.ESP.Objects[player] = text
end

function AdvanceTech:RemoveESP(player)

    local text =
        self.State.ESP.Objects[player]

    if not text then
        return
    end

    text.Visible = false

    pcall(function()
        text:Remove()
    end)

    self.State.ESP.Objects[player] = nil
end

function AdvanceTech:UpdateESP()

    local settings = self.Settings.ESP

    for player, text in pairs(
        self.State.ESP.Objects
    ) do

        --------------------------------------------------
        -- Disabled
        --------------------------------------------------

        if not settings.Enabled then
            text.Visible = false

        --------------------------------------------------
        -- Player removed
        --------------------------------------------------

        elseif not player
            or not player.Parent then

            self:RemoveESP(player)

        --------------------------------------------------
        -- Team check
        --------------------------------------------------

        elseif not self:IsESPEnemy(player) then

            text.Visible = false

        else

            local character =
                player.Character

            if not character then

                text.Visible = false

            else

                local head =
                    character:FindFirstChild("Head")

                local root =
                    character:FindFirstChild(
                        "HumanoidRootPart"
                    )

                local humanoid =
                    character:FindFirstChildOfClass(
                        "Humanoid"
                    )

                if not head
                    or not root
                    or not humanoid
                    or humanoid.Health <= 0 then

                    text.Visible = false

                else

                    local screenPosition, onScreen =
                        Camera:WorldToViewportPoint(
                            head.Position
                        )

                    if not onScreen then

                        text.Visible = false

                    else

                        --------------------------------------------------
                        -- Build ESP text
                        --------------------------------------------------

                        local output = ""

                        if settings.ShowDistance then

                            local localCharacter =
                                LocalPlayer.Character

                            local localRoot =
                                localCharacter
                                and localCharacter:FindFirstChild(
                                    "HumanoidRootPart"
                                )

                            if localRoot then

                                local distance =
                                    (
                                        root.Position
                                        - localRoot.Position
                                    ).Magnitude

                                output =
                                    "("
                                    .. tostring(
                                        math.floor(distance)
                                    )
                                    .. ") "
                            end
                        end

                        output =
                            output
                            .. player.Name

                        if settings.ShowHealth then

                            output =
                                output
                                .. " ["
                                .. tostring(
                                    math.floor(
                                        humanoid.Health
                                    )
                                )
                                .. "]"
                        end

                        --------------------------------------------------
                        -- Apply ESP
                        --------------------------------------------------

                        text.Text = output

                        text.Position =
                            Vector2.new(
                                screenPosition.X,
                                screenPosition.Y - 25
                            )

                        text.Size =
                            settings.TextSize

                        text.Center =
                            settings.Center

                        text.Outline =
                            settings.Outline

                        text.OutlineColor =
                            settings.OutlineColor

                        text.Color =
                            settings.TextColor

                        text.Transparency =
                            settings.TextTransparency

                        if settings.Font then
                            text.Font =
                                settings.Font
                        end

                        text.Visible = true
                    end
                end
            end
        end
    end
end

function AdvanceTech:InitializeESP()

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then
            self:CreateESP(player)
        end
    end

    Players.PlayerAdded:Connect(
        function(player)

            if player ~= LocalPlayer then
                self:CreateESP(player)
            end
        end
    )

    Players.PlayerRemoving:Connect(
        function(player)
            self:RemoveESP(player)
        end
    )
end

